# 本地 pnpm dev：浏览器仍请求相对路径 /admin-api 等，由 Vite 代理到下列地址
# 覆盖方式：复制为 .env.development.local 或 export 环境变量

VITE_ADMIN_API_TARGET=http://127.0.0.1:6001
VITE_CONTENT_API_TARGET=http://127.0.0.1:6002
VITE_VIDEO_API_TARGET=http://127.0.0.1:8080

# 可选：开发时也直连网关（不走 Vite 代理），取消注释并注释掉上方 TARGET
# VITE_ADMIN_API_BASE=https://api.dramadjbo.com/admin-api
# VITE_CONTENT_API_BASE=https://api.dramadjbo.com/content-api
# VITE_VIDEO_API_BASE=https://api.dramadjbo.com/video-api
