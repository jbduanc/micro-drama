server:
  port: 6002
  servlet:
    context-path: /content-api

spring:
  datasource:
    url: jdbc:postgresql://postgres:5432/content_db
    username: postgres
    password: "${DB_PASSWORD}"
    driver-class-name: org.postgresql.Driver
  redis:
    host: redis
    port: 6379
    password: "${REDIS_PASSWORD}"
    database: 0

jwt:
  secret: "${JWT_SECRET}"
  access-expire: 900000

auth:
  gateway:
    mode: kong

grpc:
  server:
    port: 9091
