server:
  port: 6010

spring:
  redis:
    host: ${REDIS_HOST:redis}
    port: ${REDIS_PORT:6379}
    password: ${REDIS_PASSWORD:}
    database: ${REDIS_DATABASE:0}

jwt:
  secret: ${JWT_SECRET:CHANGE_ME}
  access-expire: ${JWT_ACCESS_EXPIRE:7200000}
  refresh-expire: ${JWT_REFRESH_EXPIRE:2592000000}

# api.dramadjbo.com 域下 httpOnly Cookie（admin + 小程序共用网关域）
auth:
  cookie:
    domain: ${AUTH_COOKIE_DOMAIN:.dramadjbo.com}
    secure: ${AUTH_COOKIE_SECURE:true}
